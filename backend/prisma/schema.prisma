// Prisma schema for Travel Pioneers (Prisma 7).
//
// In Prisma 7 the generator must specify an `output` path (Prisma Client is
// no longer emitted into `node_modules`), and the datasource no longer
// holds connection strings — those are configured in `prisma.config.ts`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma-js"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  member
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(member)
  views        String[]  @default(["supplier-intelligence"])
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now())      @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt           @map("updated_at") @db.Timestamptz(6)

  contractRuns ContractRun[]

  @@index([email])
  @@map("users")
}

/**
 * Persisted record of a Supplier Intelligence agent run that successfully
 * generated an xlsx in step 3. One row per generated contract — global
 * scope (every authenticated user can read every run; `processedById`
 * is kept for audit only, not for filtering, and may be null once the
 * user that ran it has been deleted).
 *
 * The 52 product fields are stored as JSONB rather than as columns to keep
 * the schema agile while the agent is still calibrating: shared/manual/
 * catalog values come from three different shapes that each evolve at
 * their own pace, and the per-row data is naturally a list of variable
 * length (~1..21 product×season combinations). Querying individual fields
 * isn't required for the current product surface (history list + counts).
 */
model ContractRun {
  id              String   @id @default(uuid()) @db.Uuid
  /**
   * User who hit "Descargar xlsx". Kept for audit only; not used to filter.
   * Nullable + ON DELETE SET NULL so a run is never tied to a user's
   * lifetime: deleting the user keeps the history row and simply drops the
   * reference.
   */
  processedById   String?  @map("processed_by_id") @db.Uuid
  processedBy     User?    @relation(fields: [processedById], references: [id], onDelete: SetNull)
  processedAt     DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  /**
   * Client-generated idempotency key, one per extraction (Paso 3 result).
   * The xlsx can be downloaded several times for the same extraction
   * (Paso 3 "Descargar aquí", Paso 4 auto-download, re-clicks); every save
   * upserts on this key so one extraction is exactly one history row and
   * is counted once in the dashboard. Nullable for rows created before the
   * key existed.
   */
  extractionId    String?  @unique @map("extraction_id") @db.Uuid

  /** Original uploaded filename (no path), e.g. `parador_2026.pdf`. */
  filename        String
  /** One of "pdf" | "docx" | "xlsx" — kept loose to avoid an enum migration the day a new format is added. */
  fileKind        String   @map("file_kind")
  /** Size in bytes of the uploaded contract. */
  fileSize        Int      @map("file_size")

  /** Echo of `SharedFields` — the ~17 fields that appear once per contract. */
  sharedFields    Json     @map("shared_fields")
  /** Array of `ContractRow` JSON objects — one per product × season combination. */
  rows            Json
  /** Catalog prefill from `lista-proveedores` when the supplier already existed. Null for new suppliers. */
  catalogPrefill  Json?    @map("catalog_prefill")
  /** User-entered fields from step 2 that the AI doesn't extract. Nullable. */
  manualFields    Json?    @map("manual_fields")

  /** AI model used for the extraction (e.g. `claude-opus-4-7`). */
  aiModel         String   @map("ai_model")

  /**
   * Token usage reported by Anthropic for the extraction call (no thinking
   * because tool_choice is forced — see `service.ts`). Nullable for back-
   * compat with rows created before this column existed and as a safety
   * valve when Anthropic's `usage` object happens to be missing.
   */
  inputTokens     Int?     @map("input_tokens")
  outputTokens    Int?     @map("output_tokens")
  /**
   * Costo estimado del run en USD según la pricing actual de Claude Opus
   * 4.6 ($5/MTok input, $25/MTok output al 2026-02). Se computa server-side
   * a partir de los token counts y los precios constantes en `service.ts`
   * — si Anthropic cambia tarifas, hay que actualizar esos constants antes
   * de que afecten a runs nuevos. Float (PG `DOUBLE PRECISION`) es
   * suficiente para nuestro rango de costos (centavos a ~$10/run).
   */
  costUsd         Float?   @map("cost_usd")

  @@index([processedAt(sort: Desc)])
  @@index([processedById])
  @@map("contract_runs")
}

/**
 * Maestro de proveedores ("lista-proveedores"). Antes era un .ts generado
 * en build desde un xlsx; ahora vive en la DB para que los admins lo
 * administren desde el portal. Un proveedor tiene N servicios.
 *
 * `codigo` es la llave de negocio (columna C del xlsx de salida) y se
 * mantiene única; `id` existe para que renombrar un código no rompa URLs.
 */
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  /** Código corto del maestro (columna "proveedor"). */
  codigo    String   @unique
  /** Nombre comercial (columna "Nombre"). */
  nombre    String?
  /** Tipo de actividad (columna "Actividad"), ej. HO, TR. */
  actividad String?
  /** Zona / destino turístico (columna "Zona"). */
  zona      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt      @map("updated_at") @db.Timestamptz(6)

  servicios SupplierService[]

  @@index([nombre])
  @@map("suppliers")
}

model SupplierService {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /** Código de servicio (columna "Servicio"). */
  codigo      String
  /** Descripción libre (columna "Descripción"). */
  descripcion String?
  /**
   * En el xlsx, Actividad y Zona vienen por fila (= por servicio) y ~30
   * proveedores mezclan varias (hotel + tours + transporte). Las guardamos
   * por servicio para no perder información; el valor del proveedor es el
   * más frecuente y sirve de fallback cuando el servicio no tiene el suyo.
   */
  actividad   String?
  zona        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([supplierId, codigo])
  @@map("supplier_services")
}
